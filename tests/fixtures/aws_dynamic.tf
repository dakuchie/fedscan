# Pattern from a widely used community module: the subject condition is generated by a dynamic block.
data "aws_iam_policy_document" "dynamic_sub" {
  statement {
    actions = ["sts:AssumeRoleWithWebIdentity"]
    principals {
      type        = "Federated"
      identifiers = ["arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"]
    }
    condition {
      test     = "StringEquals"
      variable = "token.actions.githubusercontent.com:aud"
      values   = ["sts.amazonaws.com"]
    }
    dynamic "condition" {
      for_each = local.merge_conditions
      content {
        test     = condition.value.test
        variable = "token.actions.githubusercontent.com:sub"
        values   = condition.value.values
      }
    }
  }
}
